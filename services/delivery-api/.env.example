# Copy to .env (do not commit .env). Required for serverless deploy of delhiveryWebhookWorker (VPC).
# Use subnets khanal-prod-lambda-nat-1a + 1b and SG khanal-prod-sg-delivery-api-lambda in the same region as deploy (e.g. ap-south-1).
LAMBDA_VPC_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
LAMBDA_VPC_SUBNET_ID_1=subnet-xxxxxxxxxxxxxxxxx
LAMBDA_VPC_SUBNET_ID_2=subnet-xxxxxxxxxxxxxxxxx

DATABASE_URL=postgresql://USER:PASS@host:5432/dbname?sslmode=require
DELHIVERY_WEBHOOK_SECRET=
POD_S3_BUCKET=
