# Copy to .env (do not commit .env).
DATABASE_URL=postgresql://USER:PASS@host:5432/safexpress_prod?sslmode=require
SAP_SL_USE_SSM=true
HANA_USE_SSM=1
# SafeExpress credentials are read from SSM (/safexpress/credentials,
# /safexpress/token) — see src/safexpress/credentials.py's docstring for
# the JSON shape. Not settable via env vars; populate SSM directly.
