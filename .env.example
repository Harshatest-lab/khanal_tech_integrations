# Example environment variables (copy to .env — do not commit real values)

# Database (local Docker or RDS Proxy URL)
DATABASE_URL=postgresql://app:postgres@127.0.0.1:5432/ecommerce

# Frappe server → Lambda ingest (POST delhivery-tracking-snapshot)
FRAPPE_INGEST_API_KEY=change-me

# Optional: Delhivery → Lambda webhook shared secret header
# DELHIVERY_WEBHOOK_SECRET=
LOG_LEVEL=INFO

# Stage name (dev | staging | prod)
STAGE=dev
